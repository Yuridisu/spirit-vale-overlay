{
  "name": "spirit-vale-overlay",
  "version": "0.10.14",
  "private": true,
  "type": "module",
  "author": "kar-mi",
  "description": "Spirit Vale Overlay",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/packages/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "bun run --filter @svoverlay/desktop build",
    "build:stable": "bun run --filter @svoverlay/desktop build",
    "build:electron": "bun run --filter @svoverlay/desktop-electron build",
    "check": "bun run typecheck && bun test --parallel",
    "dev": "bun run --filter @svoverlay/desktop dev",
    "dev:electron": "bun run --filter @svoverlay/desktop-electron dev",
    "package:portable": "bun run --filter @svoverlay/desktop package",
    "package:electron": "bun run --filter @svoverlay/desktop-electron package",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit",
    "verify:portable": "bun run tooling/release/verify-portable.ts",
    "verify:portable:electron": "bun run tooling/release/verify-portable.ts --shell electron",
    "capture:dump": "bun run tools/packages/cli/src/dump.ts",
    "capture:combat": "bun run tools/packages/cli/src/dump.ts --protocols udp --combat-only",
    "combat:replay": "bun run tools/packages/cli/src/combat.ts",
    "direction:debug": "bun run tools/packages/cli/src/direction-debug.ts",
    "generate:rpc-map": "bun run tools/scripts/generate-rpc-map.ts",
    "generate:combat-semantics": "bun run tools/scripts/generate-combat-semantics.ts",
    "generate:static-catalogs": "bun run tools/scripts/generate-static-catalogs.ts",
    "market": "bun run tools/packages/cli/src/market.ts",
    "rewards": "bun run tools/packages/cli/src/rewards.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "pe-library": "1.0.1",
    "typescript": "7.0.2",
    "zip-lib": "1.4.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
